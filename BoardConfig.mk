DEVICE_PATH := device/huawei/marie

# Architecture
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv8-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_VARIANT := generic
TARGET_CPU_VARIANT_RUNTIME := cortex-a73
TARGET_2ND_ARCH := arm
TARGET_2ND_ARCH_VARIANT := armv8-a
TARGET_2ND_CPU_ABI := armeabi-v7a
TARGET_2ND_CPU_ABI2 := armeabi
TARGET_2ND_CPU_VARIANT := generic
TARGET_2ND_CPU_VARIANT_RUNTIME := cortex-a73

# Platform
TARGET_BOARD_PLATFORM := kirin710
TARGET_BOOTLOADER_BOARD_NAME := kirin710
TARGET_NO_BOOTLOADER := true
TARGET_OTA_ASSERT_DEVICE := marie,HWMAR,MAR-LX1B,MAR-L21B
DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE := $(DEVICE_PATH)/vintf/compatibility_matrix.device.xml

$(call soong_config_set_bool,libui,legacy_gralloc,true)

# Kernel (Linux 6.12, Clang/LLVM)
TARGET_KERNEL_ARCH := arm64
TARGET_KERNEL_SOURCE := kernel/huawei/kirin710
TARGET_KERNEL_CONFIG := kirin710_defconfig
TARGET_KERNEL_CLANG_COMPILE := true
BOARD_KERNEL_IMAGE_NAME := Image.gz
BOARD_KERNEL_BASE := 0x00000000
BOARD_KERNEL_PAGESIZE := 2048
BOARD_MKBOOTIMG_ARGS += \
    --header_version 1 \
    --kernel_offset 0x00080000 \
    --ramdisk_offset 0x07c00000 \
    --second_offset 0x00f00000 \
    --tags_offset 0x07a00000

# Physical partitions. Huawei's _a GPT names do not indicate A/B updates.
AB_OTA_UPDATER := false
BOARD_USES_RECOVERY_AS_BOOT := false
BOARD_FLASH_BLOCK_SIZE := 4096
BOARD_BOOTIMAGE_PARTITION_SIZE := 25165824
BOARD_SYSTEMIMAGE_PARTITION_SIZE := 2424307712
BOARD_PRODUCTIMAGE_PARTITION_SIZE := 2256535552
BOARD_VENDORIMAGE_PARTITION_SIZE := 503316480
BOARD_ODMIMAGE_PARTITION_SIZE := 100663296
BOARD_CACHEIMAGE_PARTITION_SIZE := 109051904
BOARD_RECOVERYIMAGE_PARTITION_SIZE := 33554432
BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_ODMIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true
TARGET_COPY_OUT_VENDOR := vendor
TARGET_COPY_OUT_ODM := odm
TARGET_COPY_OUT_PRODUCT := product

# Native vendor image (EROFS + EMUI 9 VNDK 28 HALs + Android 17 HWC3/minigbm + Mesa Panfrost)
VENDOR_SECURITY_PATCH := 2018-06-19
BUILD_BROKEN_DUP_RULES := true
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
BOARD_VENDORIMAGE_FILE_SYSTEM_TYPE := erofs
BOARD_EROFS_USE_LEGACY_COMPRESSION := true
BOARD_VENDORIMAGE_EROFS_COMPRESSOR := lz4hc,level=12
BOARD_VENDORIMAGE_SELINUX_FILE_CONTEXTS := $(DEVICE_PATH)/vendor_build/vendor_file_contexts
BOARD_VENDORIMAGE_HARDLINKS := $(DEVICE_PATH)/vendor_build/vendor-hardlinks.txt
BOARD_VENDORIMAGE_POST_PROCESS_CMD := python3 $(DEVICE_PATH)/graphics/isolate-vndk28.py
BOARD_VENDORIMAGE_POST_PROCESS_DEPS := $(DEVICE_PATH)/graphics/isolate-vndk28.py
TARGET_FS_CONFIG_GEN += $(DEVICE_PATH)/vendor_build/config.fs
TARGET_VENDOR_PROP += $(DEVICE_PATH)/vendor_build/vendor.prop
include $(DEVICE_PATH)/vendor_build/vendor-vndk28.mk

# Huawei loads recovery from recovery_ramdisk with a separate kernel.
ifeq ($(MARIE_BUILD_RECOVERY),true)
BOARD_EXCLUDE_KERNEL_FROM_RECOVERY_IMAGE := true
BOARD_USES_FULL_RECOVERY_IMAGE := true
TARGET_RECOVERY_FSTAB := $(DEVICE_PATH)/configs/fstab.kirin710
else
TARGET_NO_RECOVERY := true
endif
TARGET_SKIP_OTA_PACKAGE := true

BOARD_ROOT_EXTRA_FOLDERS += sec_storage metadata


# Wi-Fi (Android 17 AIDL IWifi + wpa_supplicant with WPA3-SAE + hostapd)
BOARD_WPA_SUPPLICANT_DRIVER := NL80211
WPA_SUPPLICANT_VERSION := VER_0_8_X
BOARD_HOSTAPD_DRIVER := NL80211
BOARD_HOSTAPD_CONFIG_80211W_MFP_OPTIONAL := true
WIFI_HIDL_UNIFIED_SUPPLICANT_SERVICE_RC_ENTRY := true
$(call soong_config_set,wifi,board_wlan_device,emulator)

# SELinux
SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += $(DEVICE_PATH)/sepolicy/private

include vendor/huawei/marie/BoardConfigVendor.mk

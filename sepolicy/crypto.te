# SPDX-License-Identifier: Apache-2.0
# These services and bundled libraries run only in recovery.
type marie_rpmb_device, dev_type;

recovery_only(`
# The Huawei RPMB agent opens this UFS device from a kernel thread.
allow kernel marie_rpmb_device:chr_file { getattr open read write ioctl };
# Preserve the stock TEE storage labels used by the installed EMUI filesystem.
type teecd_data_file, file_type, data_file_type;
type teecd_data_file_vendor, file_type, data_file_type;
allow teecd_data_file self:filesystem associate;
allow init teecd_data_file:filesystem { mount relabelto relabelfrom };
allow init teecd_data_file:dir mounton;
allow tee { teecd_data_file teecd_data_file_vendor }:dir create_dir_perms;
allow tee { teecd_data_file teecd_data_file_vendor }:file create_file_perms;
# The Huawei Android 9 TEE agent requires executable mappings and verifies the
# calling HAL process context before passing its client device handle.
allow tee self:process execmem;
# The stock linker receives its executable descriptor from the recovery launcher.
allow { hal_keymaster_default hal_gatekeeper_default } recovery:fd use;
allow tee { hal_keymaster_default hal_gatekeeper_default }:dir { search read open getattr };
allow tee { hal_keymaster_default hal_gatekeeper_default }:file { read open getattr };
allow tee { hal_keymaster_default hal_gatekeeper_default }:process getattr;
allow { hal_keymaster_default hal_gatekeeper_default } tee:unix_stream_socket connectto;
allow { hal_keymaster_default hal_gatekeeper_default } tee:fd use;
allow { hal_keymaster_default hal_gatekeeper_default } tee_device:chr_file { read write open getattr ioctl };
allow { hal_keymaster_default hal_gatekeeper_default } default_prop:file { read open getattr map };
# The launcher clears inherited variables and supplies only the stock library
# path; the stock linker must retain it across this service transition.
allow recovery { hal_keymaster_default hal_gatekeeper_default }:process noatsecure;
')

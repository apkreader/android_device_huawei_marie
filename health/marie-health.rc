service vendor.health-default /vendor/bin/hw/android.hardware.health-service.marie
    class hal
    user system
    group system
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w

on charger
    wait /sys/class/power_supply/Battery/capacity 15
    chmod 0664 /sys/class/leds/lcd_backlight0/brightness
    chown system system /sys/class/leds/lcd_backlight0/brightness
    write /sys/class/leds/lcd_backlight0/brightness 128
    start vendor.charger

service vendor.charger /vendor/bin/hw/android.hardware.health-service.marie --charger
    class charger
    disabled
    seclabel u:r:charger_vendor:s0
    user system
    group system graphics wakelock input
    capabilities SYS_BOOT
    file /dev/kmsg w
    file /sys/fs/pstore/console-ramoops-0 r
    file /sys/fs/pstore/console-ramoops r
    file /proc/last_kmsg r

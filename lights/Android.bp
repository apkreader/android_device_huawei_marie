cc_binary {
    name: "android.hardware.lights-service.marie",
    relative_install_path: "hw",
    srcs: ["Lights.cpp"],
    init_rc: ["lights-marie.rc"],
    vintf_fragment_modules: ["lights-marie.xml"],
    shared_libs: [
        "android.hardware.light-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

vintf_fragment {
    name: "lights-marie.xml",
    src: "lights-marie.xml",
}

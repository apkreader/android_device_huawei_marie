package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex_vndk {
    name: "com.android.vndk.v28",
    defaults: ["vndk-apex-defaults"],
    manifest: "configs/vndk28-apex.json",
    vndk_version: "28",
    system_ext_specific: true,
}

vintf_compatibility_matrix {
    name: "framework_compatibility_matrix.3.xml",
    stem: "compatibility_matrix.3.xml",
    srcs: ["vintf/compatibility_matrix.3.xml"],
    kernel_configs: ["kernel_config_p_4.9"],
}

# MAR-LX1B partition layout.
# source                                      mount point   type   mount flags       fs_mgr flags
/dev/block/bootdevice/by-name/system           /system_root  erofs  ro                wait
/dev/block/bootdevice/by-name/vendor           /vendor       erofs  ro                wait
/dev/block/bootdevice/by-name/odm              /odm          erofs  ro                wait
/dev/block/bootdevice/by-name/product          /product      erofs  ro                wait
/dev/block/bootdevice/by-name/cust             /cust         erofs  ro                wait
/dev/block/bootdevice/by-name/version          /version      erofs  ro                wait
/dev/block/bootdevice/by-name/preload          /preload      erofs  ro                wait
/dev/block/bootdevice/by-name/preas            /preas        erofs  ro                wait
/dev/block/bootdevice/by-name/preavs           /preavs       erofs  ro                wait
/dev/block/bootdevice/by-name/cache            /cache        ext4   nosuid,nodev      wait
/dev/block/bootdevice/by-name/userdata         /data         f2fs   nosuid,nodev,noatime,discard,inline_data,inline_xattr wait,fileencryption=aes-256-xts:aes-256-cts,reservedsize=20M
/dev/block/bootdevice/by-name/recovery_ramdisk  /recovery     emmc   defaults          defaults
/dev/block/bootdevice/by-name/erecovery_ramdisk /erecovery    emmc   defaults          defaults
/dev/block/bootdevice/by-name/kernel           /kernel       emmc   defaults          defaults
/dev/block/bootdevice/by-name/erecovery_kernel  /erecovery_kernel emmc defaults        defaults
/dev/block/bootdevice/by-name/misc             /misc         emmc   defaults          defaults
/dev/block/mmcblk1p1                           /external_sd  auto   defaults          defaults

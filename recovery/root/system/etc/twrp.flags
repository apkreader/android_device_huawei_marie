/system_root erofs /dev/block/bootdevice/by-name/system flags=display="System";backup=1
/vendor erofs /dev/block/bootdevice/by-name/vendor flags=display="Vendor";backup=1
/odm erofs /dev/block/bootdevice/by-name/odm flags=display="ODM";backup=1
/product erofs /dev/block/bootdevice/by-name/product flags=display="Product";backup=1
/cust erofs /dev/block/bootdevice/by-name/cust flags=display="Cust";backup=1
/version erofs /dev/block/bootdevice/by-name/version flags=display="Version";backup=1
/preload erofs /dev/block/bootdevice/by-name/preload flags=display="Preload";backup=1
/data f2fs /dev/block/bootdevice/by-name/userdata flags=display="Data";backup=1
/recovery emmc /dev/block/bootdevice/by-name/recovery_ramdisk flags=display="Recovery ramdisk";backup=1;flashimg
/erecovery emmc /dev/block/bootdevice/by-name/erecovery_ramdisk flags=display="eRecovery ramdisk";backup=1
/kernel emmc /dev/block/bootdevice/by-name/kernel flags=display="Android kernel";backup=1
/erecovery_kernel emmc /dev/block/bootdevice/by-name/erecovery_kernel flags=display="eRecovery kernel";backup=1
/external_sd auto /dev/block/mmcblk1p1 /dev/block/mmcblk1 flags=display="MicroSD";storage;removable

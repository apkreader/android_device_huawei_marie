+	bool copyLegacySyntheticKeys(userid_t user_id) {
+		if (!android::base::GetBoolProperty("ro.aera.crypto.legacy_keystore", false)) return true;
+		const std::string user = "user_" + std::to_string(user_id);
+		const std::string source = "/data/misc/keystore/" + user;
+		DIR* directory = opendir(source.c_str());
+		if (!directory) return errno == ENOENT;
+		const std::string target = "/tmp/misc/keystore/" + user;
+		if (mkdir(target.c_str(), 0700) != 0 && errno != EEXIST) {
+			closedir(directory);
+			return false;
+		}
+		bool ok = true;
+		while (dirent* entry = readdir(directory)) {
+			const std::string name = entry->d_name;
+			if (name.rfind("1000_USRPKEY_synthetic_password_", 0) != 0 &&
+				name.rfind(".1000_chr_USRPKEY_synthetic_password_", 0) != 0) continue;
+			int input = openat(dirfd(directory), name.c_str(), O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+			struct stat st;
+			if (input < 0) { ok = false; break; }
+			std::string data;
+			bool read = fstat(input, &st) == 0 && S_ISREG(st.st_mode) &&
+				st.st_size > 0 && st.st_size <= 1048576 && android::base::ReadFdToString(input, &data);
+			close(input);
+			if (!read) { ok = false; break; }
+			const std::string destination = target + "/" + name;
+			int output = open(destination.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC | O_NOFOLLOW, 0600);
+			if (output < 0 && errno == EEXIST) continue;
+			if (output < 0) { ok = false; break; }
+			ok = android::base::WriteFully(output, data.data(), data.size());
+			close(output);
+			if (!ok) { unlink(destination.c_str()); break; }
+		}
+		closedir(directory);
+		return ok;
+	}

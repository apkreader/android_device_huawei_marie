+static bool evictKeyLegacy(const std::string& raw_ref) {
+    key_serial_t ring = keyctl_search(KEY_SPEC_SESSION_KEYRING, "keyring", "e4crypt", 0);
+    if (ring < 0) return errno == ENOKEY;
+    bool success = true;
+    for (const char* prefix : {"ext4", "f2fs", "fscrypt"}) {
+        const std::string name = std::string(prefix) + ":" + keyrefstring(raw_ref);
+        key_serial_t key = keyctl_search(ring, "logon", name.c_str(), 0);
+        if (key < 0 && errno == ENOKEY) continue;
+        if (key < 0 || keyctl_unlink(key, ring) < 0) {
+            PLOG(ERROR) << "Cannot remove legacy filesystem key";
+            success = false;
+        }
+    }
+    return success;
+}

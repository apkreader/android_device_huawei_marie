+static bool installKeyLegacy(const KeyBuffer& key, const std::string& raw_ref) {
+    if (key.size() != 64) {
+        LOG(ERROR) << "Legacy keyring requires a 64-byte AES-XTS key";
+        return false;
+    }
+    key_serial_t ring = keyctl_search(KEY_SPEC_SESSION_KEYRING, "keyring", "e4crypt", 0);
+    if (ring < 0 && errno == ENOKEY)
+        ring = add_key("keyring", "e4crypt", nullptr, 0, KEY_SPEC_SESSION_KEYRING);
+    if (ring < 0) {
+        PLOG(ERROR) << "Cannot open legacy filesystem keyring";
+        return false;
+    }
+    // Workers may have started with a different session keyring.
+    if (keyctl_search(KEY_SPEC_SESSION_KEYRING, "keyring", "e4crypt",
+                      KEY_SPEC_USER_KEYRING) < 0) {
+        PLOG(ERROR) << "Cannot share legacy filesystem keyring";
+        return false;
+    }
+    KeyBuffer buffer(sizeof(fscrypt_key), 0);
+    auto* payload = reinterpret_cast<fscrypt_key*>(buffer.data());
+    payload->mode = FSCRYPT_MODE_AES_256_XTS;
+    payload->size = key.size();
+    memcpy(payload->raw, key.data(), key.size());
+    for (const char* prefix : {"ext4", "f2fs", "fscrypt"}) {
+        const std::string name = std::string(prefix) + ":" + keyrefstring(raw_ref);
+        if (add_key("logon", name.c_str(), buffer.data(), buffer.size(), ring) < 0) {
+            PLOG(ERROR) << "Cannot install legacy filesystem key";
+            return false;
+        }
+    }
+    return true;
+}

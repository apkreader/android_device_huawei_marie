 #include <algorithm>
 #include <string>
+#include <sstream>
 
 namespace aera::wifi {
 
+inline std::string ScanSecurity(const std::string& flags,
+                                const std::string& key_management) {
+  bool supports_sae = key_management.empty();
+  std::istringstream capabilities(key_management);
+  std::string capability;
+  while (capabilities >> capability) {
+    if (capability == "SAE") supports_sae = true;
+  }
+  const bool sae = flags.find("SAE") != std::string::npos;
+  const bool psk = flags.find("PSK") != std::string::npos;
+  // Transition networks offer PSK to clients without SAE. Keep SAE-only
+  // networks identified as WPA3 rather than treating them as open or WPA2.
+  if (sae && (!psk || supports_sae)) return "WPA3";
+  if (flags.find("WPA2") != std::string::npos || flags.find("RSN") != std::string::npos)
+    return "WPA2";
+  if (flags.find("WPA") != std::string::npos) return "WPA";
+  return "OPEN";
+}

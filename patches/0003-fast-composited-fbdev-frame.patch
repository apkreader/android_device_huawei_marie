+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+namespace minui_software_frame {
+inline bool Copy(const uint8_t *source, int sw, int sh, size_t source_stride,
+                 uint8_t *destination, int dw, int dh, size_t destination_stride) {
+  if (!source || !destination || sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0 ||
+      static_cast<size_t>(sw) > SIZE_MAX / 4 || static_cast<size_t>(dw) > SIZE_MAX / 4 ||
+      source_stride < static_cast<size_t>(sw) * 4 || destination_stride < static_cast<size_t>(dw) * 4 ||
+      source_stride > SIZE_MAX / static_cast<size_t>(sh) ||
+      destination_stride > SIZE_MAX / static_cast<size_t>(dh)) return false;
+  // Retain the map between frames: no framebuffer-sized allocations or
+  // per-pixel divides in the presentation loop.
+  static thread_local std::vector<size_t> columns;
+  static thread_local int previous_sw = 0, previous_dw = 0;
+  if (sw != dw && (previous_sw != sw || previous_dw != dw)) {
+    columns.resize(dw);
+    for (int x = 0; x < dw; ++x)
+      columns[x] = static_cast<size_t>(static_cast<int64_t>(x) * sw / dw) * 4;
+    previous_sw = sw; previous_dw = dw;
+  }
+  for (int y = 0; y < dh; ++y) {
+    const size_t sy = static_cast<size_t>(static_cast<int64_t>(y) * sh / dh);
+    const uint8_t *row = source + sy * source_stride;
+    uint8_t *output = destination + static_cast<size_t>(y) * destination_stride;
+    if (sw == dw) {
+      std::memcpy(output, row, static_cast<size_t>(dw) * 4);
+    } else {
+      for (int x = 0; x < dw; ++x)
+        std::memcpy(output + static_cast<size_t>(x) * 4, row + columns[x], 4);
+    }
+  }
+  return true;
+}
+}  // namespace minui_software_frame

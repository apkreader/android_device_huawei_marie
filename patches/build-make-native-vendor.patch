+def ApplyStagingHardlinks(staging_directory, manifest):
+  """Share storage for identical files with matching filesystem metadata."""
+  with open(manifest) as entries:
+    for entry in entries:
+      source, destination = entry.rstrip("\n").split("\t")
+      for path in (source, destination):
+        if path != os.path.normpath(path) or path in (".", "..") or path.startswith(("/", "../")):
+          raise ValueError(f"Invalid hardlink path: {path}")
+      source = os.path.join(staging_directory, source)
+      destination = os.path.join(staging_directory, destination)
+      if (source == destination or os.path.islink(source) or os.path.islink(destination)
+          or not filecmp.cmp(source, destination, shallow=False)):
+        raise ValueError(f"Image hardlink files differ: {source}, {destination}")
+      os.unlink(destination)
+      os.link(source, destination)
+
+

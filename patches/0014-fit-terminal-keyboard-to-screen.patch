+int KeyboardTop(TerminalUi *state) {
+  const int inset = std::clamp(android::base::GetIntProperty<int>(
+      "ro.aera.ui.bottom_inset", 0), 0, 240);
+  const int screen_height = lv_obj_get_height(state->screen);
+  const int height = state->landscape ? 768 : 1098;
+  return std::max(0, std::min(state->landscape ? 500 : 2070,
+                            screen_height - height - inset));
+}

--- /dev/null
+++ b/aeraui/platform/battery_sysfs.hpp
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+namespace aeraui::battery_sysfs {
+// The native UI must use the same device path as the recovery backend.
+// root permits host fixtures without accessing the build host's battery.
+inline std::string Directory(const std::string &root = "") {
+  const char *paths[] = {
+#ifdef AERA_CUSTOM_BATTERY_PATH
+      AERA_CUSTOM_BATTERY_PATH,
+#endif
+      "/sys/class/power_supply/battery",
+      "/sys/class/power_supply/Battery",
+      "/sys/class/power_supply/bms",
+  };
+  for (const char *path : paths) {
+    const std::string directory = root + path;
+    FILE *file = fopen((directory + "/capacity").c_str(), "re");
+    if (!file) continue;
+    int capacity = -1;
+    const bool valid = fscanf(file, "%d", &capacity) == 1 && capacity >= 0 && capacity <= 100;
+    fclose(file);
+    if (valid) return directory;
+  }
+  return {};
+}
+inline long ReadNumber(const char *name, const std::string &root = "") {
+  const std::string directory = Directory(root);
+  if (directory.empty()) return -1;
+  FILE *file = fopen((directory + "/" + name).c_str(), "re");
+  if (!file) return -1;
+  long value = -1;
+  if (fscanf(file, "%ld", &value) != 1) value = -1;
+  fclose(file);
+  return value;
+}
+inline bool Charging(const std::string &root = "") {
+  const std::string directory = Directory(root);
+  if (directory.empty()) return false;
+  FILE *file = fopen((directory + "/status").c_str(), "re");
+  if (!file) return false;
+  char status[32] = {};
+  const bool read = fgets(status, sizeof(status), file) != nullptr;
+  fclose(file);
+  return read && (!strncmp(status, "Charging", 8) || !strncmp(status, "Full", 4));
+}
+}  // namespace aeraui::battery_sysfs

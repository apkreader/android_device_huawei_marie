# Hardware defaults from the EMUI 9.1 vendor base.
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
persist.huawei.touch_move_opt=1
persist.huawei.touch_vsync_opt=1
persist.huawei.touchevent_opt=1
persist.kirin.alloc_buffer_sync=true
persist.kirin.media.hires.enable=true
persist.kirin.media.lowlatency.enable=true
persist.kirin.media.offload.enable=true
persist.kirin.media.usbvoice.enable=true
persist.kirin.media.usbvoice.name=USB-Audio - HUAWEI GLASS
persist.kirin.texture_cache_opt=1
persist.vendor.irqbalance.enable=true
persist.vendor.smart_pool=1
ro.bt.bdaddr_path=/data/vendor/bluedroid/macbt
ro.comp.chipset_version=Chipset-miami 9.1.0.(0F0G)
ro.kirin.config.hw_board_ipa=true
ro.kirin.config.hw_perfgenius=true
ro.kirin.product.platform=kirin710
ro.vendor.config.hw_music_lp=true
ro.vendor.config.music_lp_vol=true
ro.vendor.tui.service=true
ro.vndk.version=28
sys.usb.configfs=1
sys.usb.controller=ff100000.dwc3
vendor.debug.config.mmu_en=1

# Linux 6.12 Kirin 710 DSSv320 (4 HW planes) + drm_hwcomposer (HWC3) + minigbm + Mali-G51 Mesa Panfrost
vendor.hwc.drm.device=/dev/dri/card0
ro.vendor.hwc.use_overlay_planes=1
vendor.hwc.drm.scale_with_gpu=1
persist.graphics.egl=mesa
ro.hardware.egl=mesa
drm.gpu.vendor_name=panfrost
ro.opengles.version=196609
debug.hwui.renderer=skiagl
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.supports_background_blur=0
persist.sys.sf.disable_blurs=1
debug.sf.use_phase_offsets_as_durations=1
debug.sf.late.sf.duration=12500000
debug.sf.early.sf.duration=13500000
debug.sf.earlyGl.sf.duration=14500000
debug.sf.late.app.duration=16600000
debug.sf.early.app.duration=16600000
debug.sf.earlyGl.app.duration=16600000

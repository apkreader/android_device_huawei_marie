# <device> <mount point> <type> <mount options> <fs_mgr options>
/dev/block/by-name/system /system ext4 ro wait,first_stage_mount
/dev/block/by-name/vendor /vendor erofs ro wait,first_stage_mount
/dev/block/by-name/odm /odm erofs ro wait,first_stage_mount
/dev/block/by-name/product /product ext4 ro wait,first_stage_mount
/dev/block/by-name/userdata /data f2fs nosuid,nodev,noatime,discard,inline_data,inline_xattr wait,check,fileencryption=aes-256-xts:aes-256-cts,reservedsize=20M
/dev/block/by-name/cache /cache ext4 nosuid,nodev,noatime wait,check
/dev/block/by-name/misc /misc emmc defaults defaults
/devices/platform/hi_mci.1/mmc_host/mmc1/* auto auto defaults voldmanaged=sdcard:auto
/devices/platform/ff200000.hisi_usb/ff100000.dwc3/* auto auto defaults voldmanaged=usbotg:auto

on boot
    chown system system /sys/class/devfreq/e82c0000.mali/min_freq
    chmod 0664 /sys/class/devfreq/e82c0000.mali/min_freq
    stop CameraDaemon
    stop octty

on property:sys.boot_completed=1
    write /sys/block/zram0/comp_algorithm lz4
    swapon_all /vendor/etc/fstab.kirin710
    write /proc/sys/vm/swappiness 100

on property:init.svc.CameraDaemon=running
    stop CameraDaemon

on property:init.svc.CameraDaemon=restarting
    stop CameraDaemon

on property:init.svc.octty=running
    stop octty

on property:init.svc.octty=restarting
    stop octty

service marie-power /vendor/bin/hw/android.hardware.power-service.marie
    override
    class hal
    user system
    group system
    interface aidl android.hardware.power.IPower/default
